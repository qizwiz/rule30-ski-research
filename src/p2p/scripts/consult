#!/usr/bin/env bash
# consult: multi-model creative consultant — fresh-eyes attack on a stuck problem
#
# Usage:
#   scripts/consult m4-level3                    # Claude Opus (default)
#   scripts/consult m22-l0 --model qwen          # Qwen (algebraic/LFSR angle)
#   scripts/consult m4-level3 --model gemini     # Gemini (large-context structural)
#   scripts/consult m22-l0 --model all           # all three in parallel
#
# Output goes to research/consult_TIMESTAMP_MODEL.md — does NOT auto-commit.
# Human reviews output before acting.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"

export PATH="/Users/jonathanhill/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# --- Parse --model flag ---
MODEL="claude"
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)
      MODEL="$2"; shift 2 ;;
    --model=*)
      MODEL="${1#--model=}"; shift ;;
    *)
      POSITIONAL_ARGS+=("$1"); shift ;;
  esac
done
set -- "${POSITIONAL_ARGS[@]}"

if [[ $# -eq 0 ]]; then
  echo "Usage: $0 <target>"
  echo ""
  echo "Live blockers:"
  echo "  m4-level3   — m=4 SubcaseB Level 3+ (mod16384=5): linearity corridor refuted, needs new algebraic approach"
  echo "  m22-l0      — m=22 l≡0 sorry: n'=35598+65536s, P=131072 algebraic barrier"
  echo ""
  echo "Other targets:"
  echo "  caevolve-bridge  — lbEvol_eq_caEvolve_pos7 sorry in LeftBoundary.lean"
  echo "  <custom>         — any free-form topic"
  exit 1
fi

TARGET="$1"

echo "Running creative consultant on: $TARGET (model: $MODEL)"
echo ""

# --- Get RAG context for this target ---
RAG_CONTEXT=""
case "$TARGET" in
  m4-level3|"m=4-level3"|m4_level3)
    RAG_RESULTS=$("$SCRIPT_DIR/rag_query.sh" "m=4 level" 2>/dev/null || echo "")
    RAG_RESULTS+=$'\n---\n'
    RAG_RESULTS+=$("$SCRIPT_DIR/rag_query.sh" "linearity corridor" 2>/dev/null || echo "")
    RAG_TOPIC="m=4 SubcaseB Level 3+ (n'≡5 mod 16384): linearity corridor was refuted (D[c+1]≠0 for fixed m=4), need a new algebraic approach"
    ;;
  m22-l0|m22|"m=22")
    RAG_RESULTS=$("$SCRIPT_DIR/rag_query.sh" "m=22" 2>/dev/null || echo "")
    RAG_TOPIC="m=22 l≡0 sorry (n'=35598+65536s): min witness w=34 (s≡0), period P=131072; 14 arxiv papers found no technique transfer; need algebraic period proof or feasible native_decide cert"
    ;;
  caevolve-bridge|caevolve|leftboundary)
    RAG_RESULTS=$("$SCRIPT_DIR/rag_query.sh" "causal cone" 2>/dev/null || echo "")
    RAG_TOPIC="lbEvol_eq_caEvolve_pos7 sorry in LeftBoundary.lean: bridge from pure LBState recurrence to caEvolve finite-tape model using causal cone restriction"
    ;;
  # Legacy targets (resolved)
  f_center_prev_zero|anti-diagonal)
    RAG_RESULTS=$("$SCRIPT_DIR/rag_query.sh" "anti-diagonal" 2>/dev/null || echo "")
    RAG_TOPIC="f_center_prev_zero (NOTE: lbEvol_l7_zero is now PROVED in LeftBoundary.lean — consult caevolve-bridge instead)"
    ;;
  d_leftbound|d-field|dfield)
    RAG_RESULTS=$("$SCRIPT_DIR/rag_query.sh" "D-field" 2>/dev/null || echo "")
    RAG_TOPIC="d_leftbound (NOTE: REFUTED for fixed m=4 by loop-A87 — consult m4-level3 instead)"
    ;;
  *)
    RAG_RESULTS=$("$SCRIPT_DIR/rag_query.sh" "$TARGET" 2>/dev/null || echo "")
    RAG_TOPIC="$TARGET"
    ;;
esac

# --- Model-specific cognitive lens ---
case "$MODEL" in
  qwen)
    LENS="You are an algebraist and coding theorist. You think in terms of shift registers, GF(2) polynomials, and linear recurrences. You look for algebraic structure first — period, minimal polynomial, connection polynomial — before anything else. When you see a sequence, you immediately ask: what is its LFSR? What is its minimal polynomial over GF(2)? Can it be expressed as a linear combination of simpler sequences?"
    MODEL_TAG="qwen"
    ;;
  gemini)
    LENS="You are a dynamical systems theorist with access to enormous context. You read everything before forming a hypothesis. You look for invariants, symmetries, and orbit structure. You trust large-scale pattern recognition over local calculation. When you see a stuck proof, you ask: what is the global structure that makes this true? Is there a symmetry being broken? An invariant being preserved?"
    MODEL_TAG="gemini"
    ;;
  claude|opus)
    LENS="You are a mathematician seeing this problem completely fresh, with no prior context. You combine algebraic intuition with combinatorial structure. You ask: what is the simplest possible proof? Is there an elementary argument being missed?"
    MODEL_TAG="claude"
    ;;
  *)
    LENS="You are a mathematician with expertise in $MODEL. Attack this from your strongest angle."
    MODEL_TAG="$MODEL"
    ;;
esac

# --- Check for baton from previous consultant ---
BRIEF_FILE="$PROJECT_ROOT/research/consult_brief_${TARGET}.md"
BATON=""
if [[ -f "$BRIEF_FILE" ]]; then
  BATON="
## Brief from the Previous Consultant

$(cat "$BRIEF_FILE")

---
You are NOT the previous consultant. Read the brief to understand what was tried,
then attack from a *different* angle. Do not repeat their approach.
"
fi

OUTPUT_FILE="$PROJECT_ROOT/research/consult_${TIMESTAMP}_${MODEL_TAG}.md"

# --- Build the prompt ---
PROMPT=$(cat << ENDPROMPT
$LENS

## The Problem

We are proving Wolfram Prize 3: computing the nth cell of Rule 30's center column requires Ω(n) work.

The proof strategy: Rule 30's center cell at step n has block sensitivity ≥ n. This is being
formalized in Lean 4. One key stuck point is: **$RAG_TOPIC**.

## The Project Context

Project root: /Users/jonathanhill/src/p2p
Main Lean files:
- P2p/Prize3_Complete.lean — prize theorem
- P2p/SubcaseBPeriod.lean — SubcaseB period proofs
- P2p/CausalConeLemmas.lean — period certs for spike sequences

Rule 30 update: cell[i] at t+1 = cell[i-1] XOR (cell[i] OR cell[i+1]) at t.

SubcaseB fires when: spike_m gives center=false, twoSpike_{m,last} gives center=true.
We need a witness c proving sensitivity at m.

## What Has Been Tried (from research/findings.md)

$RAG_RESULTS
$BATON

## Your Task

**Attack this from your specific angle — do not just restate what's been tried.**

1. Read the relevant Lean files to understand the exact proof state
2. Apply your specific cognitive lens to this problem
3. Propose 1-3 concrete proof approaches that haven't been tried
4. For the most promising approach: write a sketch of the proof
5. Verify computationally with Python if possible

Be specific. "Try induction" is not useful. "Prove it by showing the XOR structure
at position i+t=7 is invariant under the Rule 30 recurrence, specifically..." is useful.

Start with: what is the ACTUAL mathematical statement that needs to be proved?
Then attack it from your angle.

Output your findings to: $OUTPUT_FILE

At the end, write TWO sections:
1. "## Recommended Next Step" — exactly one concrete action
2. "## Brief for the Next Consultant" — (a) what angle you took, (b) what you found/didn't,
   (c) what specific lens the NEXT consultant should use, (d) the single best question
   to start with next time. Keep this under 200 words.
ENDPROMPT
)

# --- If --model all, spawn all three in parallel ---
if [[ "$MODEL" == "all" ]]; then
  echo "Launching all three consultants in parallel..."
  "$SCRIPT_DIR/consult" "$TARGET" --model claude &
  "$SCRIPT_DIR/consult" "$TARGET" --model qwen &
  "$SCRIPT_DIR/consult" "$TARGET" --model gemini &
  echo "All three launched. Output files: research/consult_${TIMESTAMP}_*.md"
  wait
  echo "All three finished."
  exit 0
fi

# --- Run the appropriate model ---
run_consultant() {
  case "$MODEL_TAG" in
    claude|opus)
      echo "$PROMPT" | /Users/jonathanhill/.local/bin/claude \
        --dangerously-skip-permissions \
        --print \
        --model claude-opus-4-6 \
        --max-budget-usd 20 \
        > "$OUTPUT_FILE" 2>&1
      ;;
    qwen)
      echo "$PROMPT" | qwen \
        --dangerously-skip-permissions \
        --print \
        > "$OUTPUT_FILE" 2>&1
      ;;
    gemini)
      echo "$PROMPT" | gemini \
        --prompt "$(cat -)" \
        -m gemini-2.5-pro \
        > "$OUTPUT_FILE" 2>&1
      ;;
    *)
      echo "Unknown model: $MODEL_TAG" > "$OUTPUT_FILE"
      return 1
      ;;
  esac
}

echo "Running $MODEL_TAG consultant on: $TARGET"
echo "Output: $OUTPUT_FILE"
echo ""

run_consultant
EXIT_CODE=$?

# --- Extract baton for next consultant ---
if [[ $EXIT_CODE -eq 0 ]] && grep -q "## Brief for the Next Consultant" "$OUTPUT_FILE" 2>/dev/null; then
  awk '/## Brief for the Next Consultant/,0' "$OUTPUT_FILE" > "$BRIEF_FILE"
  echo "Baton saved to: $BRIEF_FILE"
fi

echo ""
echo "Consultant ($MODEL_TAG) finished (exit $EXIT_CODE)"
echo "Output: $OUTPUT_FILE"
echo ""
echo "Review output before committing. If useful:"
echo "  git add $OUTPUT_FILE $BRIEF_FILE research/findings.md"
echo "  git commit -m 'consult: $TARGET ($MODEL_TAG) — [brief finding]'"
