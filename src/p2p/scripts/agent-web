#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RUNTIME="$ROOT/runtime"
PID_FILE="$RUNTIME/agent_web.pid"
LOG_FILE="$RUNTIME/agent_web.log"
PORT="${PORT:-8765}"

mkdir -p "$RUNTIME"

is_alive() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

listener_pid() {
  { lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true; } | head -n 1
}

case "${1:-start}" in
  start)
    if [[ -f "$PID_FILE" ]]; then
      existing="$(cat "$PID_FILE" 2>/dev/null || true)"
      if is_alive "$existing"; then
        echo "already running on pid $existing"
        exit 0
      fi
      live_listener="$(listener_pid)"
      if is_alive "$live_listener"; then
        echo "$live_listener" > "$PID_FILE"
        echo "already running on pid $live_listener"
        exit 0
      fi
      rm -f "$PID_FILE"
    else
      live_listener="$(listener_pid)"
      if is_alive "$live_listener"; then
        echo "$live_listener" > "$PID_FILE"
        echo "already running on pid $live_listener"
        exit 0
      fi
    fi
    nohup python3 "$SCRIPT_DIR/agent_web.py" --port "$PORT" >"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "started http://127.0.0.1:$PORT (pid $(cat "$PID_FILE"))"
    ;;
  stop)
    live_listener="$(listener_pid)"
    if [[ -f "$PID_FILE" ]]; then
      pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if is_alive "$pid"; then
        kill "$pid"
      fi
      rm -f "$PID_FILE"
    fi
    if is_alive "$live_listener"; then
      kill "$live_listener"
    fi
    echo "stopped"
    ;;
  status)
    if [[ -f "$PID_FILE" ]]; then
      pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if is_alive "$pid"; then
        echo "running pid=$pid url=http://127.0.0.1:$PORT"
        exit 0
      fi
    fi
    live_listener="$(listener_pid)"
    if is_alive "$live_listener"; then
      echo "$live_listener" > "$PID_FILE"
      echo "running pid=$live_listener url=http://127.0.0.1:$PORT"
      exit 0
    fi
    echo "not running"
    exit 1
    ;;
  restart)
    "$0" stop >/dev/null 2>&1 || true
    "$0" start
    ;;
  *)
    echo "usage: $0 {start|stop|status|restart}" >&2
    exit 2
    ;;
esac
