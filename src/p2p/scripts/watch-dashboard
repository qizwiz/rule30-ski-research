#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SESSION="p2p-watch"
DETACHED=0
RESTART=0

for arg in "$@"; do
  case "$arg" in
    --detached)
      DETACHED=1
      ;;
    --restart)
      RESTART=1
      ;;
    *)
      echo "usage: $0 [--detached] [--restart]" >&2
      exit 2
      ;;
  esac
done

attach_or_switch() {
  if [[ "$DETACHED" -eq 1 ]]; then
    echo "$SESSION"
    return
  fi
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
  else
    exec tmux attach-session -t "$SESSION"
  fi
}

if tmux has-session -t "$SESSION" 2>/dev/null; then
  if [[ "$RESTART" -eq 1 ]]; then
    tmux kill-session -t "$SESSION"
  else
    attach_or_switch
    exit 0
  fi
fi

tmux new-session -d -s "$SESSION" -c "$ROOT" \
  "bash -lc 'cd \"$ROOT\" && clear && echo \"Worklog\" && echo \"=======\" && tail -n 80 -F research/WORKLOG.md'"
tmux rename-window -t "$SESSION":0 "rule30"

tmux split-window -h -t "$SESSION":0 -c "$ROOT" \
  "bash -lc 'cd \"$ROOT\" && while true; do clear; python3 scripts/watch_state_summary.py; sleep 5; done'"

tmux split-window -v -t "$SESSION":0.0 -c "$ROOT" \
  "bash -lc 'cd \"$ROOT\" && while true; do clear; scripts/watch_latest_queue_log.sh; sleep 5; done'"

tmux split-window -v -t "$SESSION":0.1 -c "$ROOT" \
  "bash -lc 'cd \"$ROOT\" && while true; do clear; scripts/watch_processes.sh; sleep 5; done'"

tmux select-layout -t "$SESSION":0 tiled
tmux setw -t "$SESSION":0 monitor-activity on
tmux set -t "$SESSION" mouse on

tmux new-window -t "$SESSION" -n "agents" -c "$ROOT" \
  "bash -lc 'cd \"$ROOT\" && while true; do clear; scripts/watch_agent_chat.sh; sleep 5; done'"
tmux split-window -h -t "$SESSION":1 -c "$ROOT" \
  "bash -lc 'cd \"$ROOT\" && clear && echo \"Raw Agent Chat Log\" && echo \"==================\" && tail -n 40 -F control/agent_chat.jsonl'"
tmux select-layout -t "$SESSION":1 even-horizontal

attach_or_switch
