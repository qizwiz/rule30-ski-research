/-- For any n ≥ 241, all cells are essential. Uses induction with lifting_lemma
    from the base case n=240. This single theorem replaces thousands of lines
    of individual witness theorems. -/
theorem essential_for_large_n (n : Nat) (k : Fin (2 * n + 1)) (hn : n ≥ 241) :
    Essential n k := by
  let m := n - 241
  induction m generalizing k with
  | zero =>
    -- Base case: n = 241, lift from n = 240
    have hn' : n = 241 := by omega
    subst hn'
    by_cases hk0 : k.val = 0
    · -- Left boundary
      have : k = ⟨0, by omega⟩ := Fin.ext hk0
      rw [this]; exact essential_left_boundary 241
    · by_cases hkmax : k.val = 2 * 241
      · -- Right boundary
        have : k = ⟨482, by omega⟩ := Fin.ext hkmax
        rw [this]; exact essential_right_boundary 241 (by omega)
      · -- Interior: lift from n=240
        have h240 : Essential 240 ⟨k.val - 1, by
          have : k.val > 0 := Nat.pos_of_ne_zero hk0
          have : k.val < 2 * 241 := by intro h; apply hkmax; omega
          omega⟩ := cast_essential_n240 _
        exact lifting_lemma 240 ⟨k.val - 1, by omega⟩ h240
  | succ m ih =>
    -- Inductive step: lift from n = 241 + m to n = 242 + m
    let n := 241 + m + 1
    by_cases hk0 : k.val = 0
    · -- Left boundary
      have : k = ⟨0, by omega⟩ := Fin.ext hk0
      rw [this]; exact essential_left_boundary n
    · by_cases hkmax : k.val = 2 * n
      · -- Right boundary
        have : k = ⟨2 * n, by omega⟩ := Fin.ext hkmax
        rw [this]; exact essential_right_boundary n (by omega)
      · -- Interior: lift from previous n
        have hprev : Essential (n - 1) ⟨k.val - 1, by
          have : k.val > 0 := Nat.pos_of_ne_zero hk0
          have : k.val < 2 * n := by intro h; apply hkmax; omega
          omega⟩ := ih ⟨k.val - 1, by omega⟩
        exact lifting_lemma (n - 1) ⟨k.val - 1, by omega⟩ hprev


