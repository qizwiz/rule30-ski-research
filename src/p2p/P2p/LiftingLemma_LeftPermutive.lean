          exact absurd ((by native_decide : rule30n 7 (fun k : Fin 15 => decide (k.val = 4)) = true) ▸ hcase) (by decide)
        · -- m=6: THE sub-case B. Witness: position 2 true.
          have hm_eq : m = ⟨6, by omega⟩ := Fin.ext h6
