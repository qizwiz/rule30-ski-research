set_option maxHeartbeats 400000000 in
/-- Even Case B sub-case B existence: when e_m → false AND two_spike{m, last_even} → true,
    there still exists an odd-false config c_n sensitive at even non-rightmost m.

    This is a WEAKER statement than the analogous odd invariant: for even m, the
    two-spike{m, last_even} does NOT always equal e_m. Counterexamples:
    - N=6, m=4: e_m → false, but two_spike{4,12} → true (gap between spikes matters)
    - N=7, m=6: e_m → false, but two_spike{6,14} → true

    The witnesses for these sub-case B instances are non-uniform:
    - (n'=5, m=4): requires two-even-spike {2,6} (no single even spike works)
    - (n'=6, m=6): single delta_2 works
    - (n'=9, m=12): single delta_8 works
    No uniform formula is known.

    Computationally verified for n=1..19: the sub-case B instances all have at least
    one odd-false witness, but the witnesses depend on (n, m) in a complex way.

    STATUS: Correctly stated. Finding a uniform construction or inductive proof is OPEN. -/
lemma parity_sensitivity_even_subcaseB (n' : Nat) (m : Fin (2 * (n' + 1) + 1))
    (hm_even : m.val % 2 = 0)
    (hm_low : 1 ≤ m.val)
    (hm_ne_r : m.val ≠ 2 * n')
    (hm_high : m.val + 1 < 2 * (n' + 1) + 1)
    (hcase : rule30n (n' + 1) (fun k : Fin (2 * (n' + 1) + 1) =>
               decide (k.val = m.val)) = false)
    (hts : rule30n (n' + 1) (fun k : Fin (2 * (n' + 1) + 1) =>
             decide (k.val = m.val ∨ k.val = 2 * (n' + 1))) = true) :
    ∃ c_n : Config (n' + 1),
      (∀ k : Fin (n' + 1), c_n ⟨2 * k.val + 1, by omega⟩ = false) ∧
      rule30n (n' + 1) c_n ≠ rule30n (n' + 1) (flipCell c_n m) := by
  -- Sub-case B (hcase ∧ hts simultaneously) first occurs at n'=5.
  -- For n'=0..4, the hypotheses are contradictory (proved below).
  -- For n'≥5, a uniform proof is open: the witness depends on (n',m) in a
  -- non-uniform pseudo-random way not captured by the hypotheses alone.
  -- Computationally verified for n'=5..18; proof requires deep Rule 30 structure.
  by_cases hn5 : 5 ≤ n'
  · -- n'≥5: split on n'=5 exactly vs n'≥6.
    by_cases hn5_eq : n' = 5
    · -- n'=5 exactly: Config size=13, level=6. Valid even m with constraints: {2,4,6,8}.
      subst hn5_eq
      have hm_lt : m.val < 13 := m.isLt
      have hm_cases : m.val = 2 ∨ m.val = 4 ∨ m.val = 6 ∨ m.val = 8 := by omega
      rcases hm_cases with h2 | h4 | h6 | h8
      · -- m=2: rule30n 6 (e_2 ∪ e_12) = false, contradicting hts (which claims true).
        have hm_eq : m = ⟨2, by omega⟩ := Fin.ext h2
        rw [hm_eq] at hts
        exact absurd ((by native_decide : rule30n 6 (fun k : Fin 13 => decide (k.val = 2 ∨ k.val = 12)) = false) ▸ hts) (by decide)
      · -- m=4: THE sub-case B. Witness: positions {2,6} true, all odd-false, sensitive at 4.
        have hm_eq : m = ⟨4, by omega⟩ := Fin.ext h4
        -- Witness function
        let c26 : Config 6 := fun k : Fin 13 => decide (k.val = 2 ∨ k.val = 6)
        -- odd-false: 2*k.val+1 is odd, so ≠ 2 and ≠ 6 (both even), giving false.
        have hodd : ∀ k : Fin 6, c26 ⟨2 * k.val + 1, by omega⟩ = false := by
          intro k
          simp only [c26, decide_eq_false_iff_not]
          omega
        -- sensitive at 4: verified computationally.
        have hsens : rule30n 6 c26 ≠ rule30n 6 (flipCell c26 (4 : Fin 13)) := by
          native_decide
        rw [hm_eq]
        exact ⟨c26, hodd, hsens⟩
      · -- m=6: rule30n 6 (e_6 ∪ e_12) = false, contradicting hts (which claims true).
        have hm_eq : m = ⟨6, by omega⟩ := Fin.ext h6
        rw [hm_eq] at hts
        exact absurd ((by native_decide : rule30n 6 (fun k : Fin 13 => decide (k.val = 6 ∨ k.val = 12)) = false) ▸ hts) (by decide)
      · -- m=8: rule30n 6 e_8 = true, contradicting hcase (which claims false).
        have hm_eq : m = ⟨8, by omega⟩ := Fin.ext h8
        rw [hm_eq] at hcase
        exact absurd ((by native_decide : rule30n 6 (fun k : Fin 13 => decide (k.val = 8)) = true) ▸ hcase) (by decide)
    · -- n'≥6: split on n'=6 vs n'≥7
      by_cases hn6_eq : n' = 6
