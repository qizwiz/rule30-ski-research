            rw [hm_eq] at hts
            exact absurd ((by native_decide : rule30n 8 (fun k : Fin 17 => decide (k.val = 10 ∨ k.val = 16)) = false) ▸ hts) (by decide)
          · -- m=12: hcase fails (e_12 → true)
