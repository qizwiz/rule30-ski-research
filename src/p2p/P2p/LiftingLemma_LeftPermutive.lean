            rw [hm_eq] at hcase
            exact absurd ((by native_decide : rule30n 8 (fun k : Fin 17 => decide (k.val = 12)) = true) ▸ hcase) (by decide)
          · -- m=14: excluded by hm_ne_r (m.val ≠ 2*7 = 14)
